{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "types": [
      "node"
    ],
    "lib": [
      "es2020"
    ],
    "outDir": "out",
    "sourceMap": true,
    "rootDir": "src/main",
    "strict": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "examples",
    "scripts"
  ],
  "include": [
    "src/main/**/*.ts"
  ]
}