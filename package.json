{
  "name": "ng-alain-vscode",
  "displayName": "NG-ALAIN Snippets",
  "description": "Snippets based on NG-ALAIN",
  "version": "18.0.0",
  "icon": "ng-alain.png",
  "publisher": "cipchk",
  "license": "MIT",
  "licenseUrl": "LICENSE",
  "homepage": "https://github.com/cipchk/ng-alain-vscode/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/cipchk/ng-alain-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/cipchk/ng-alain-vscode/issues",
    "email": "cipchk@qq.com"
  },
  "scripts": {
    "watch": "tsx scripts/esbuild.ts --watch",
    "build": "tsx scripts/esbuild.ts",
    "package": "npm run build && vsce package",
    "resource": "node scripts/snippet.js",
    "release": "npm run resource && npm run package"
  },
  "engines": {
    "vscode": "^1.30.0"
  },
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "light"
  },
  "main": "./out/extension",
  "categories": [
    "Snippets",
    "Other",
    "Programming Languages"
  ],
  "extensionPack": [
    "cipchk.ng-zorro-vscode"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ng-alain-vscode.cache",
        "title": "%ng-alain-vscode.cache%"
      }
    ],
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets-ts.json"
      },
      {
        "language": "html",
        "path": "./snippets-html.json"
      }
    ],
    "configuration": {
      "title": "NG-ALAIN Extension Configuration",
      "properties": {
        "ng-alain-vscode.i18nStatus": {
          "description": "%ng-alain-vscode.i18nStatus%",
          "type": "boolean",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ],
          "default": "auto"
        },
        "ng-alain-vscode.classMode": {
          "description": "%ng-alain-vscode.classMode%",
          "type": "string",
          "enum": [
            "disabled",
            "hover",
            "enabled"
          ],
          "enumDescriptions": [
            "%ng-alain-vscode.classMode.disabled%",
            "%ng-alain-vscode.classMode.hover%",
            "%ng-alain-vscode.classMode.enabled%"
          ],
          "default": "enabled"
        },
        "ng-alain-vscode.i18nPipeName": {
          "description": "%ng-alain-vscode.i18nPipeName%",
          "type": "string",
          "default": "i18n"
        },
        "ng-alain-vscode.i18nData": {
          "description": "%ng-alain-vscode.i18nData%",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "%ng-alain-vscode.i18nData.path%"
              },
              "type": {
                "type": "string",
                "description": "%ng-alain-vscode.i18nData.type%",
                "enum": [
                  "file",
                  "url",
                  "node"
                ],
                "default": "file"
              },
              "remoteOptions": {
                "type": "object",
                "description": "%ng-alain-vscode.i18nData.remoteOptions%"
              }
            }
          },
          "default": []
        },
        "ng-alain-vscode.lessBuildPaths": {
          "description": "%ng-alain-vscode.lessBuildPaths%",
          "type": "array",
          "default": "[]",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.2.0",
    "less": "^4.2.0",
    "node-fetch": "^2.6.1",
    "vscode-nls": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@types/less": "^3.0.8",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.6",
    "vscode": "^1.1.37",
    "vscode-snippet-generator": "^1.3.2"
  },
  "packageManager": "yarn@4.14.1"
}
